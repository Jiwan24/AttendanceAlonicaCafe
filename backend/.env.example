# ─── Database ────────────────────────────────────────────────
# Lokal (SQLite):
# DATABASE_URL=sqlite:///./alonica_attendance.db
#
# Cloud (PostgreSQL — Render/Railway):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./alonica_attendance.db

# ─── Face Recognition ────────────────────────────────────────
SIMILARITY_THRESHOLD=0.55
MAX_FACES_PER_EMPLOYEE=5

# ─── Server ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── CORS ────────────────────────────────────────────────────
# Untuk multiple frontend URLs, pisahkan dengan koma:
# FRONTEND_URL=https://your-frontend.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ─── Admin Auth ──────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_dengan_password_aman
SECRET_KEY=ganti_dengan_secret_key_random_64_karakter
