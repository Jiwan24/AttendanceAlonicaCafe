@startuml Sequence_Absensi_Simple
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Inter
skinparam sequenceFontSize 13
skinparam sequenceArrowColor #374151
skinparam sequenceLifeLineBorderColor #6366F1
skinparam sequenceParticipantBackgroundColor #EEF2FF
skinparam sequenceParticipantBorderColor #6366F1
skinparam sequenceActorBackgroundColor #F3F4F6
skinparam sequenceActorBorderColor #374151
skinparam noteBorderColor #D97706
skinparam noteBackgroundColor #FFFBEB
skinparam sequenceDividerBackgroundColor #F3F4F6
skinparam sequenceDividerBorderColor #9CA3AF

title Sequence Diagram — Proses Absensi Wajah\nAlonica Cafe Attendance System

actor "Karyawan" as User
participant "Halaman Absen\n(Browser)" as FE
participant "Backend\n(FastAPI)" as BE
database "Database\n(SQLite)" as DB

== Mulai Absen ==

User -> FE : Klik ABSEN MASUK
FE -> FE : Aktifkan deteksi wajah
FE -> User : Tampilkan kamera aktif

User -> FE : Arahkan wajah ke kamera
FE -> FE : Wajah stabil 5 frame\n→ Capture foto

== Kirim ke Server ==

FE -> BE : POST /verify-face\n{ foto, jenis: "masuk" }

== Cek Anti-Spoofing ==

BE -> BE : Analisis gambar\n(Laplacian, LBP, FFT)

alt Terdeteksi foto/layar HP
    BE --> FE : ❌ Spoof terdeteksi
    FE -> User : "Gunakan wajah langsung,\nbukan foto"
    note right : Selesai — tolak
else Wajah asli ✓
end

== Kenali Wajah ==

BE -> BE : Bandingkan dengan\ndata wajah karyawan

alt Wajah tidak dikenali
    BE --> FE : ❌ Tidak cocok
    FE -> User : Coba lagi\n(maks 3×)
    note right : Setelah 3× gagal\n→ PIN fallback
else Wajah cocok ✓
end

== Validasi & Simpan ==

BE -> DB : Cek absensi hari ini
DB --> BE : Status (sudah/belum absen)

alt Sudah absen masuk hari ini
    BE --> FE : ⚠️ Sudah tercatat
    FE -> User : "Kamu sudah absen\nmasuk hari ini"
else Belum absen
    BE -> DB : Simpan log absensi\n(nama, waktu, metode, skor)
    DB --> BE : Tersimpan ✓
    BE --> FE : ✅ Berhasil\n{ nama, jenis, kecocokan% }
    FE -> User : "MASUK BERHASIL"\nNama — Kecocokan 87%
end

@enduml
